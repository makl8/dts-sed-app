{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "pull-request-title-pattern": "chore: release ${version}",
    "include-v-in-tag": true,
    "initial-version": "0.0.1",
    "changelog-sections": [
        {
            "type": "feat",
            "section": "🚀 Features",
            "hidden": false
        },
        {
            "type": "fix",
            "section": "🐛 Bug Fixes",
            "hidden": false
        },
        {
            "type": "deps",
            "section": "⬆️ Dependency Updates",
            "hidden": false
        },
        {
            "type": "chore",
            "section": "🧰 Maintenance",
            "hidden": false
        },
        {
            "type": "build",
            "section": "🧰 Maintenance",
            "hidden": false
        },
        {
            "type": "docs",
            "section": "🧰 Maintenance",
            "hidden": false
        },
        {
            "type": "ops",
            "section": "🧰 Maintenance",
            "hidden": false
        },
        {
            "type": "style",
            "section": "🎨 Code Style",
            "hidden": false
        },
        {
            "type": "refactor",
            "section": "🔧 Refactoring",
            "hidden": false
        },
        {
            "type": "revert",
            "section": "⏪ Reverts",
            "hidden": false
        },
        {
            "type": "test",
            "section": "🧪 Tests",
            "hidden": false
        }
    ],
    "packages": {
        ".": {
            "changelog-path": "CHANGELOG.md",
            "release-type": "simple",
            "extra-files": [
                "README.md",
                "pyproject.toml",
                "templates/_footer.html"
            ]
        }
    }
}
